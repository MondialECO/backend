// Template documenting required configuration. Copy values into one of:
//   - User Secrets (local dev):  dotnet user-secrets set "MongoDbSettings:ConnectionString" "..."
//   - Environment variables (prod/staging), using __ as the section separator:
//       MongoDbSettings__ConnectionString, JwtSettings__Key, EmailSettings__Password, etc.
//   - appsettings.Development.json (git-ignored, local only)
// NEVER put real secret values in appsettings.json (it is committed).
{
  "MongoDbSettings": {
    "ConnectionString": "mongodb+srv://<user>:<password>@<cluster>.mongodb.net/",
    "DatabaseName": "MondialEcoDev"
  },
  "JwtSettings": {
    "Issuer": "mondialbusiness.eu",
    "Audience": "mondialbusiness.eu",
    "Key": "<cryptographically-random-256-bit-base64-string>",
    "ExpiryHours": 8
  },
  "EmailSettings": {
    "SmtpServer": "smtp.zoho.com",
    "Port": 587,
    "Email": "<smtp-account>",
    "Password": "<smtp-password>"
  },
  "Twilio": {
    "AccountSid": "<twilio-account-sid>",
    "AuthToken": "<twilio-auth-token>",
    "FromNumber": "<twilio-from-number>"
  },
  "Redis": {
    "Configuration": "<host:port>,password=<password>,ssl=True,abortConnect=False",
    "InstanceName": "Mondial"
  },
  "Cors": {
    "AllowedOrigins": [ "https://your-frontend-domain" ]
  },
  "AllowedHosts": "*"
}
